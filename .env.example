PORT=3000

# Comma-separated list of allowed browser origins for CORS. Only frontend-web
# and admin-web need this (native mobile requests aren't subject to CORS).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# Base URL of zipmart-frontend-web — used to build links embedded in emails
# (password reset, staff invite, etc.), never called server-to-server.
FRONTEND_URL=http://localhost:4200

# Postgres runs natively on this machine (not Docker), default port 5432.
# Pinned to 127.0.0.1 (not "localhost"): an unrelated Docker Postgres
# container on this machine also binds 5432 over IPv6 (::), and Node can
# resolve "localhost" to ::1 and hit that container instead.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=zipmart
DB_PASSWORD=zipmart
DB_NAME=zipmart

# Redis still runs via docker-compose.yml — host-mapped to 6380 (not the
# default 6379) because this machine already runs another Redis container
# on 6379 for an unrelated project.
REDIS_HOST=localhost
REDIS_PORT=6380

# Seconds, not duration strings — required by the installed jsonwebtoken types.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Internal-only, not exposed to any client. Empty/unreachable is fine before
# zipmart-backend-spring exists — recommendations fall back to top-selling.
BACKEND_SPRING_URL=http://localhost:8080

# Product image storage — see docs/PROJECT-CLOUDINARY-IMAGE-STORAGE.md.
# Get these from the Cloudinary dashboard (free tier): Account details.
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# Infra D — VNPay (see src/payments). Sandbox merchant credentials from the
# VNPay merchant portal. VNPAY_URL defaults to the sandbox pay endpoint if unset.
VNPAY_TMN_CODE=change-me
VNPAY_HASH_SECRET=change-me
VNPAY_RETURN_URL=http://localhost:4200/orders/payment-return
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Infra D — Momo (see src/payments). Sandbox merchant credentials from the
# Momo business portal. MOMO_ENDPOINT/MOMO_IPN_URL default to Momo's test
# gateway / MOMO_RETURN_URL if unset.
MOMO_PARTNER_CODE=change-me
MOMO_ACCESS_KEY=change-me
MOMO_SECRET_KEY=change-me
MOMO_RETURN_URL=http://localhost:4200/orders/payment-return
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_IPN_URL=http://localhost:3000/api/v1/payments/momo/ipn

# A.4 — Google/Facebook OAuth (see src/auth/google.strategy.ts, facebook.strategy.ts).
# Get these from the Google Cloud Console / Facebook Developer Console.
# Callback URLs must be registered there exactly as configured here.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
FACEBOOK_APP_ID=change-me
FACEBOOK_APP_SECRET=change-me
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/facebook/callback

# A.6 — loyalty points (see src/loyalty). LOYALTY_EARN_RATE = points earned
# per 1đ of order total (default 1 point / 1,000đ spent). LOYALTY_REDEMPTION_RATE
# = đ value of 1 point when redeemed at checkout (default 100đ/point).
LOYALTY_EARN_RATE=0.001
LOYALTY_REDEMPTION_RATE=100

# A.8 — Web Push (see src/notifications). Generate a real pair with
# `npx web-push generate-vapid-keys`. Push sending is skipped entirely
# (logged once at boot) if these are left unset/empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@zipmart.example.com
